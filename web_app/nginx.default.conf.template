# SPA fallback for the built React Router app — see
# context/pre-deployment-checklist.md item 6 / context/decisions-log.md.
#
# Every client-side route (/roster/2, /people/new, ...) only exists in
# React Router's in-memory history; a static file server that doesn't know
# this returns a real 404 for a direct URL or a page refresh at any of
# those paths, since no matching file exists on disk. `try_files ... /index.html`
# is the fix: for any request that doesn't match a real file, serve
# index.html instead and let React Router take over client-side — the
# exact production-hosting analog of the dev-proxy path-collision bugs
# this project already found and fixed twice (see decisions-log.md).
#
# `${PORT}` is substituted by the official nginx image's own
# docker-entrypoint templating (any *.template file under
# /etc/nginx/templates/ is run through envsubst automatically on container
# start — no custom entrypoint script needed) — Railway assigns this
# dynamically per deploy, never a fixed port, same requirement as the
# backend's own $PORT binding.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets get real 404s (not the SPA fallback) — a missing JS/CSS
    # chunk should fail loudly, not silently serve HTML in its place.
    location /assets/ {
        try_files $uri =404;
    }
}
