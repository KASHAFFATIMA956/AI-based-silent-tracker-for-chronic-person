# Copy to .env and fill in for local/dev use.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Railway/Neon/Supabase all provide a connection string in this shape.
DATABASE_URL=postgresql+psycopg2://roznoor:roznoor@localhost:5432/roznoor

APP_NAME=RozNoor API
ENVIRONMENT=development

# JWT auth. MUST be set to a real secret outside local/hackathon dev —
# app/core/config.py's default is intentionally insecure. The app will
# REFUSE TO START with this default once ENVIRONMENT above isn't
# "development" — see app/core/config.py's forbid_insecure_secret_outside_dev
# validator. Generate a real one with: openssl rand -hex 32
JWT_SECRET_KEY=insecure-dev-only-secret-change-me

# CORS — comma-separated list of EXACT allowed origins, never a wildcard.
# Defaults (if left unset) cover Vite's own dev port on localhost/127.0.0.1
# — see app/core/config.py. Set to the real deployed frontend origin(s) in
# production, e.g. https://roznoor-web.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Claude API (app/services/ai.py). Optional: leave unset to run with the
# rule engine only — every AI-dependent endpoint soft-fails gracefully
# (POST /entries falls back to source='rule'; the AI summary endpoint
# returns available=false) when this is missing or invalid.
ANTHROPIC_API_KEY=

# Voice Diary audio uploads (app/services/audio_analysis.py). Left unset
# here (falls back to the plain relative "audio_storage" — fine for local
# dev). On Railway, set this to a path INSIDE a mounted Volume, e.g.
# AUDIO_STORAGE_PATH=/data/audio_storage (with the Volume mounted at
# /data) so uploaded recordings survive a redeploy — see
# context/pre-deployment-checklist.md item 7.
AUDIO_STORAGE_PATH=audio_storage
