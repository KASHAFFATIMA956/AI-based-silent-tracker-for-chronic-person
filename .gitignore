# Root-level ignores. Backend/ and mobile_app/ each have their own
# .gitignore for stack-specific build artifacts (venv, .dart_tool, build/,
# etc.) — this file only covers things at the repo root.

# Session-local Claude Code tooling config (e.g. sandbox DISPLAY default) —
# specific to one dev machine's automation setup, not part of the project.
.claude/

# OS/editor cruft
.DS_Store
*.swp
