<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed for the app's own API calls (ApiClient/Dio) in every build
         type, not just debug's hot-reload/VM-service connection — the
         debug/profile manifests already add this for their own reasons,
         but a release build needs it declared here too. See
         context/conventions.md ("Running the phone app on the real
         backend over LAN"). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Required by the speech_to_text plugin (Voice Diary's microphone
         button) — per that package's own README "Android" section. Without
         RECORD_AUDIO declared here, Android won't let the app request (or
         be granted) it at runtime at all — SpeechToText.initialize() calls
         ActivityCompat.requestPermissions() for RECORD_AUDIO internally
         (see speech_to_text's SpeechToTextPlugin.kt), so no separate
         Dart-side permission-request call is needed; the manifest
         declaration alone was the missing piece. The BLUETOOTH* permissions
         are for optional Bluetooth-headset mic input during recognition —
         harmless to declare even without a headset. See
         context/conventions.md and context/decisions-log.md. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <application
        android:label="roznoor_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required by speech_to_text on targetSdk 30+ (this project's
             flutter.targetSdkVersion is well above that) — without this,
             the app can't see/bind to the device's speech recognition
             service at all due to Android's package-visibility rules, even
             with RECORD_AUDIO granted. Per speech_to_text's README
             ("Android SDK 30 or later" section). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
